# ═══════════════════════════════════════════════════
# UNIFY — Environment Variables
# Copy this file to .env and fill in your credentials
# ═══════════════════════════════════════════════════

# ── SUPABASE ──────────────────────────────────────
# Get from: https://supabase.com → Your Project → Settings → API
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── FIREBASE ──────────────────────────────────────
# Get from: https://console.firebase.google.com → Project Settings → General → Your Apps → SDK setup
VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# ── OPTIONAL ──────────────────────────────────────
# Firebase Cloud Messaging VAPID key (for web push)
# Get from: Firebase Console → Cloud Messaging → Web Push Certificates
VITE_FIREBASE_VAPID_KEY=BK9hXxxx...

# ── GOOGLE MAPS ─────────────────────────────────────────────
# Get from: https://console.cloud.google.com → APIs & Services → Credentials
# Enable: Maps JavaScript API, Geocoding API, Directions API
VITE_GOOGLE_MAPS_API_KEY=AIzaSy...

# ── APP CONFIG ────────────────────────────────────
# Set to 'demo' to use local mock data without a real database
# Set to 'live' to use real Supabase + Firebase data
VITE_APP_MODE=demo